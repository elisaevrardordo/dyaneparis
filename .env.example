RESEND_API_KEY=
CONTACT_FORM_FROM="Dyane Paris Website <website@mail.dyaneparis.com>"
CONTACT_FORM_TO=contact@dyaneparis.com

# Newsletter (Resend Segments / Contacts)
# Real registrations use Resend. The local preview launcher overrides this to
# preview: loopback PostgreSQL storage only, with no Resend calls or emails.
NEWSLETTER_MODE=resend
# Segment ID from https://resend.com/audiences
RESEND_SEGMENT_ID=
# Optional: sender for the welcome email (falls back to CONTACT_FORM_FROM)
NEWSLETTER_FROM="Dyane Paris <website@mail.dyaneparis.com>"
# Stable server-only signing secret, at least 32 characters. Keep it out of Git.
NEWSLETTER_UNSUBSCRIBE_SECRET=

# Keep test secrets in ignored .env.local and Preview environment variables.
# Production credentials belong exclusively in the hosting provider's server environment.
STRIPE_MODE=sandbox
STRIPE_CHECKOUT_ENABLED=false
STRIPE_LIVE_READY=false
# Optional for test payments before Tax setup. Has no effect in production.
STRIPE_SANDBOX_SKIP_AUTOMATIC_TAX=false
# Set both server-side to active, country-specific, inclusive 20% tax rates in the same Stripe mode.
# Required for live checkout; optional for manually taxed test checkout. Do not copy real IDs to Preview.
STRIPE_MANUAL_VAT_FR=
STRIPE_MANUAL_VAT_MC=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=acct_1UWul7JqLuPXMAFh
STRIPE_SITE_URL=http://localhost:3000
# Separate persistent databases for local, Preview and Production.
STRIPE_DATABASE_URL=
